# ==============================================================================
# ÁNIMAS: The Sovereign 3D Ofrenda — Environment Configuration
# ==============================================================================

# NEXT_PUBLIC_API_URL: Target FastAPI backend URL.
# - Option A (BYO-Local): "http://127.0.0.1:8000" (Default local inference daemon)
# - Option B (Cloud Container): "https://animas-api.onrender.com" (Render/Railway container)
# - Fallback: If unreachable, the frontend seamlessly uses its in-browser BM25 RAG simulator.
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
VITE_API_URL="http://127.0.0.1:8000"

# Optional Gemini API Key (if running cloud-assisted Gemma/Gemini fallback)
GEMINI_API_KEY=""

# Host & Port configuration for local FastAPI service
API_HOST="127.0.0.1"
API_PORT="8000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app"
